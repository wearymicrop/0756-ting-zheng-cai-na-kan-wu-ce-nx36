{% macro sources(evidence) %}
{% for src in evidence %}<details><summary>{{ src.table }} · 第 {{ src.line }} 行</summary><pre>{{ src.raw|tojson(indent=2) }}</pre></details>{% endfor %}
{% endmacro %}
