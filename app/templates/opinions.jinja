{% from 'exhibits.jinja' import sources, status %}
<div class="section-heading"><h2>意见索引</h2><span>{{ current['items']|length }} 组</span></div>
<div class="scroll"><table><thead><tr><th>发言人</th><th>主题</th><th>立场</th><th>锚点</th><th>发言与复述</th></tr></thead><tbody>
{% for item in current['items'] %}<tr><td>{{ item.speaker }} · {{ item.speaker_id }}</td><td>{{ item.topic }}</td><td>{{ status(item.position) }}</td><td>{{ item.anchors|join('、') }}</td><td>{{ sources(item.sources) }}</td></tr>{% else %}<tr><td colspan="5">暂无可归并意见。</td></tr>{% endfor %}</tbody></table></div>
