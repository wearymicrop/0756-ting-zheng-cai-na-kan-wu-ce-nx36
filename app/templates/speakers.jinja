{% from 'exhibits.jinja' import sources %}
<div class="section-heading"><h2>发言名册</h2><span>已识别 {{ current.identified|length }} 条</span></div>
<div class="scroll"><table><thead><tr><th>登记号</th><th>发言人</th><th>主题</th><th>来源</th></tr></thead><tbody>
{% for item in current.identified %}<tr><td>{{ item.speaker_id }}</td><td>{{ item.speaker }}</td><td>{{ item.topic }}</td><td>{{ sources([item.source, current.people[item.speaker_id].source]) }}</td></tr>{% else %}<tr><td colspan="4">没有已识别发言。</td></tr>{% endfor %}</tbody></table></div>
